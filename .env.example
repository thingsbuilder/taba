# Copie para .env e preencha, ou exporte as variáveis direto no shell.
# Nunca commite valores reais. Na VM, o mesmo conteúdo vive em /etc/taba/env (gerado pelo Ansible).
# Variável vazia vale como ausente: o padrão (entre parênteses) é usado.

# Chave da Unico (segredo)
HUMAN_TOKEN_ACCESS_KEY=
# (https://humantoken.unico.app/client/v1) trocável nos testes
UNICO_URL=
# Monta callbackUri e links
DOMAIN=
# Projeto do Firestore (obrigatória)
GCP_PROJECT=
# 32 bytes em base64; deriva person_id e volunteer_id (segredo)
HMAC_KEY=
# 32 bytes em base64; AES-GCM da miniatura (segredo)
THUMBNAIL_KEY=
# Nome e contato do responsável pelo piloto, mostrado nas telas de coleta
PILOT_RESPONSIBLE=
# (100)
SHELTER_RADIUS_M=
# (50)
EVENT_RADIUS_KM=
# (30)
INACTIVITY_DAYS=
# (30) biometria, pessoas e buscas
PURGE_AFTER_DAYS=
# (90) entregas pseudonimizadas
DELIVERY_RETENTION_DAYS=
# (7)
SESSION_DAYS=
# (10) por voluntário
SEARCHES_PER_DAY=
# (America/Sao_Paulo) fuso do dia da cota de buscas, nome IANA
TZ_PILOT=
# (0.05)
DELIVERY_SAMPLE_RATE=
# (30)
ANOMALY_CHECKINS_PER_10MIN=
# (100)
ANOMALY_RESCUES_PER_10MIN=
# (false) true liga o descarte de verdade; false só conta o que apagaria
PURGE_ENABLED=

# Só em desenvolvimento e testes: aponta a API para o emulador do Firestore.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
